# ============================================================================
# MediSense — environment example
# Copy to .env and adjust. Never commit .env.
# ============================================================================

# Demo bearer tokens (demo-token-patient, demo-token-parent, ...).
# Enabled automatically outside production. In the hosted jury demo, set this
# to true explicitly; keep it false/absent for any non-demo deployment.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# PostgreSQL (application connection)
# ---------------------------------------------------------------------------
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=medisense
SQL_USER=postgres
SQL_PASSWORD=postgres

# ---------------------------------------------------------------------------
# PostgreSQL admin connection — used only by `npm run db:push` (drizzle-kit)
# ---------------------------------------------------------------------------
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Optional AI Studio / Gemini settings (M2 currently uses pre-written templates;
# no Gemini call is made unless a future M2 implementation is enabled).
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
